# 비밀키 — 절대 커밋 금지
.env
.env.local
*.key

# 의존성
node_modules/

# 렌더링 산출물 / 임시 파일
out/
tmp/
*.log
# 모션덱 POC 비교 산출물(로컬 확인용) — 리포에 넣지 않음
published/poc/

# OS
.DS_Store
Thumbs.db

# 영상 자동 컷편집(edit_pipeline) — 촬영본·중간 결과·출력은 커밋하지 않음
edit_pipeline/input/*
edit_pipeline/work/*
edit_pipeline/output/*
edit_pipeline/index/*
!edit_pipeline/**/.gitkeep
__pycache__/
.pytest_cache/
