# 비밀키 — 절대 커밋 금지
.env
.env.local
*.key

# 의존성
node_modules/

# 렌더링 산출물 / 임시 파일
out/
tmp/
*.log
# 모션덱 POC 비교 산출물(로컬 확인용) — 리포에 넣지 않음
published/poc/

# OS
.DS_Store
Thumbs.db

# 영상 자동 컷편집(edit_pipeline) — 촬영본·중간 결과·출력은 커밋하지 않음
edit_pipeline/input/*
edit_pipeline/work/*
edit_pipeline/output/*
edit_pipeline/index/*
!edit_pipeline/**/.gitkeep
__pycache__/
.pytest_cache/
# 학습한 편집 스타일(실제 작업 XML 에서 뽑은 것: 출연자 이름·프로젝트명 포함) — 공개 저장소에 올리지 않음
edit_pipeline/config/styles/*
!edit_pipeline/config/styles/.gitkeep

# 보낼 자료(촬영본 사본) — 올리지 않음
edit_pipeline/보낼자료/
